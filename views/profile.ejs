<%- include('partials/header') -%>
  <div class="container">
    <div class="row mt-5">
      <div class="col-6">
        <div class="mt-5">
          <h2>Let's reconcile!</h2>
          <form action="/post/createPost" enctype="multipart/form-data" method="POST">
            <div class="mb-3">
              <label for="title" class="form-label">Statement Beginning Date</label>
              <input type="date" class="form-control" id="title" name="StatementBeginningDate">
              <label for="title" class="form-label">Statement Ending Date</label>
              <input type="date" class="form-control" id="title" name="StatementEndingDate">
            </div>
            <div class="mb-3">
              <label for="imgUpload" class="form-label">Accounting Software Exported Transactions</label>
              <input type="file" class="form-control" id="imageUpload" name="file">
            </div>
            <div class="mb-3">
              <label for="imgUpload" class="form-label">Bank Statement</label>
              <input type="file" class="form-control" id="imageUpload" name="file">
            </div>
            <label for="dayWindow">Possible match if dates are within
              <input type="number" id="dayWindow" name="dayWindow" value="5" min="1" max="31">
              days and amounts match</label>

            <!-- <input type="checkbox" id="ignoreSign" name="ignoreSign">
            <label for="ignoreSign">Ignore +/− sign when comparing amounts</label> -->
            <button type="submit" class="btn btn-primary" value="Upload">Compare</button>
          </form>
        </div>
      </div>
      <div class="col-6">
        <ul class="row list-unstyled">
          <% for(var i=0; i<posts.length; i++) {%>
            <li class="col-6 justify-content-between mt-5">
              <a href="/post/<%= posts[i]._id%>">
                <img class="img-fluid" src="<%= posts[i].image%>">
              </a>
            </li>
            <% } %>
        </ul>
        <div class="row justify-content-center mt-5">
          <a class="btn btn-primary" href="/allSavedMonthsRecs">See Past Month's Reconciliation Reports</a>
        </div>
      </div>
    </div>
  </div>
  </div>
  <div>
    <section>
      <h2>Transaction Review (After Compare button is hit)</h2>
      <h3>Matched Transactions = 30</h3>
      <!-- (List of matched transactions in form of: side by side transactions from Bank Statement and Transactions from Accounting Software Exported Transactions) -->
      <p><span>Bank Statement Transactions: || </span><span>Accounting Software Exported Transactions:</span></p>
      <p><span>• 09/01/2026 Check 912 $300</span><span> • 09/01/2026 Check 912 $300</span></p>
      <h3>Possible Matches</h3>
      <p><span>Bank Statement Transactions: || </span><span>Accounting Software Exported Transactions:</span></p>
      <p><span>• 09/04/2026 Check 2 $100</span><span> • 09/01/2026 Check 2 $100</span></p>
      <button type="submit" class="btn btn-primary" value="Upload">Edit</button>
      <h3>Unmatched Transactions</h3>
      <p><span>Bank Statement Transactions: || </span><span>Accounting Software Exported Transactions:</span></p>
      <!-- <h3>Unmatched Transactions: Bank Statement = 0 (This is good!)</h3>
      <p>(List of unmatched transactions: Bank statement tranasactions / Accounting Software Exported Transactions)</p>
      <h3>Unmatched Transactions: Accounting Software Exported Transactions = 23</h3>
      <p>(List of unmatched transactions: Bank statement tranasactions / Accounting Software Exported Transactions)</p> -->
      <h3>Explanation:</h3>
      <p>Unmatched transactions: 23 checks have not yet been cashed as of end of reconciled month</p>
      <button type="submit" class="btn btn-primary" value="Upload">Save Reconciliation</button>
    </section>
    <%- include('partials/footer') -%>